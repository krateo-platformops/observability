{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "krateo-observability values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "storageClassName": {
          "type": "string"
        }
      },
      "description": "Global values propagated to clickstack and its subcharts."
    },
    "otelCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "hyperdxLoadBalancer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "clickstack": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fullnameOverride": {
          "type": "string"
        },
        "clickhouse": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "limits": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "cpu": {
                      "type": "string"
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                },
                "requests": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "cpu": {
                      "type": "string"
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "otel": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "resources": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "limits": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "cpu": {
                      "type": "string"
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                },
                "requests": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "cpu": {
                      "type": "string"
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "hyperdx": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ingress": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "deployment": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "livenessProbe": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "initialDelaySeconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "periodSeconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "timeoutSeconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "failureThreshold": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                },
                "readinessProbe": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "initialDelaySeconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "periodSeconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "timeoutSeconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "failureThreshold": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                },
                "resources": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "requests": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "cpu": {
                          "type": [
                            "string",
                            "integer"
                          ]
                        },
                        "memory": {
                          "type": [
                            "string",
                            "integer"
                          ]
                        }
                      }
                    },
                    "limits": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "cpu": {
                          "type": [
                            "string",
                            "integer"
                          ]
                        },
                        "memory": {
                          "type": [
                            "string",
                            "integer"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "mongodb": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "size": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "description": "Upstream clickstack chart values, passed through opaquely."
    },
    "defaultAlerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "threshold",
              "thresholdType",
              "interval"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string"
              },
              "where": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "threshold": {
                "type": "integer",
                "description": "A row count, or a metric value for a metric alert. Typed integer, not number: crdgen types number as a string in the generated CRD."
              },
              "thresholdType": {
                "type": "string",
                "enum": [
                  "above",
                  "below",
                  "above_exclusive",
                  "below_or_equal",
                  "equal",
                  "not_equal",
                  "between",
                  "not_between"
                ]
              },
              "interval": {
                "type": "string",
                "enum": [
                  "1m",
                  "5m",
                  "15m",
                  "30m",
                  "1h",
                  "6h",
                  "12h",
                  "1d"
                ]
              },
              "tier": {
                "type": "string",
                "enum": [
                  "core",
                  "extended"
                ],
                "description": "core ships whenever defaultAlerts.enabled; extended also requires defaultAlerts.extended. Absent is treated as core."
              },
              "metricRef": {
                "type": "string",
                "minLength": 1,
                "description": "Name of a Metric in defaultMetrics to aggregate instead of counting log rows. Excludes where."
              },
              "aggregation": {
                "type": "string",
                "enum": [
                  "avg",
                  "max",
                  "min",
                  "sum",
                  "p95",
                  "increase"
                ],
                "description": "How a metric alert's points over the interval become the compared value. Required with metricRef."
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Metric alerts only: keep points whose attribute or resource attribute has this value. Resource attributes need alert-provider 0.2.61."
              },
              "metadataLabels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra labels on the Alert resource, e.g. observability.krateo.io/analysis: human."
              },
              "source": {
                "type": "string",
                "enum": [
                  "logs",
                  "traces"
                ],
                "description": "Which rows where reads: logs (default) or traces. Needs alert-provider 0.2.62. Not with metricRef."
              },
              "groupBy": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9_./-]+$"
                },
                "description": "Metric alerts only: one series per distinct value of these attribute keys, e.g. [k8s.namespace.name, k8s.pod.name, k8s.container.name]. Needs alert-provider 0.2.64."
              },
              "consecutiveWindows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "description": "Fire only once the condition has held for this many consecutive intervals; counted per series with groupBy. An empty interval restarts the count. Needs alert-provider 0.2.64."
              }
            }
          }
        },
        "extended": {
          "type": "boolean",
          "description": "Also ship the extended tier: catch-all and baseline-relative alerts whose thresholds mean 'far above normal' rather than 'anything at all', and which need retuning per cluster."
        }
      }
    },
    "defaultMetrics": {
      "type": "array",
      "description": "Metric resources the default metric alerts refer to by name.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "metricName",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "metricName": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "gauge",
              "sum",
              "histogram"
            ]
          },
          "unit": {
            "type": "string"
          },
          "collectedBy": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
