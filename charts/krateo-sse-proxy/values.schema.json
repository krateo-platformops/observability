{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "krateo-sse-proxy values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "description": "Global values shared across charts.",
      "properties": {
        "imageRegistry": {
          "type": "string",
          "description": "Optional registry host override applied to every image (repository paths preserved)."
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767,
          "description": "Explicit NodePort (only honored when service.type=NodePort). Set by the installer to pin a deterministic, host-mappable port."
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urlAuthn": {
          "type": "string",
          "description": "authn base URL for RS256/JWKS verification of end-user JWTs on /events and /notifications; the JWKS document is fetched from <urlAuthn>/.well-known/jwks.json. Empty defaults to authn in this release's namespace. Verification is mandatory by design (no open mode); set this only to point at a non-co-located authn."
        }
      }
    },
    "clickhouse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "passwordSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "optional": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "listenAddr": {
      "type": "string"
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "description": "OpenTelemetry export. Default-off; each key is emitted as an env var only when set, so the binary's own defaults stay authoritative.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Master gate (OTEL_ENABLED). The per-signal flags default to this in the binary."
        },
        "tracing": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "OTEL_TRACING_ENABLED. null inherits `enabled`."
        },
        "metrics": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "OTEL_METRICS_ENABLED. null inherits `enabled`."
        },
        "endpoint": {
          "type": "string",
          "description": "OTEL_EXPORTER_OTLP_ENDPOINT. Empty resolves to http://$(HOST_IP):4318 \u2014 the collector on this pod's own node, via a HOST_IP env projected from status.hostIP. The previous default used the collector Service's DNS name, which is HEADLESS and therefore resolves to every collector pod, so it was not node-local despite the comment that said it was. Set this only for a collector that is not on the pod's node. There is no `protocol` key: telemetry.go builds the HTTP exporters directly and they ignore OTEL_EXPORTER_OTLP_PROTOCOL."
        }
      }
    },
    "rbacScoping": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-caller event scoping (sse-proxy#29). Enabling it also grants the ServiceAccount the SubjectAccessReview and namespace-list permissions it needs, in this same chart: the flag without the grants makes every /notifications request answer 500.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "RBAC_SCOPING_ENABLED. Also creates the ClusterRole and binding the proxy needs."
        },
        "verb": {
          "type": [
            "string",
            "null"
          ],
          "description": "RBAC_SCOPING_VERB. null = the binary's default (list)."
        },
        "resource": {
          "type": [
            "string",
            "null"
          ],
          "description": "RBAC_SCOPING_RESOURCE. null = the binary's default (events)."
        },
        "apiGroup": {
          "type": [
            "string",
            "null"
          ],
          "description": "RBAC_SCOPING_APIGROUP. null = the binary's default (the core group)."
        },
        "cacheTTL": {
          "type": [
            "string",
            "null"
          ],
          "description": "RBAC_SCOPING_CACHE_TTL, a Go duration. null = the binary's default (60s)."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": true
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": true
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
